# ===== InsurDesk — configuración (copia a .env) =====
PORT=3001

# URL pública de la app (se usa en enlaces de correos y retornos de Google)
APP_URL=https://insurdesk.tudominio.com

# Administrador inicial (se crea una sola vez al arrancar con la base vacía)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia-esta-clave-ya
ADMIN_NAME=Administrador

# Secreto de sesiones. Si lo dejas vacío se genera y se guarda en el volumen de datos.
JWT_SECRET=

# --- Licencia / plan ---
# Clave que entrega el proveedor (empieza con GA1.). También se puede pegar desde la app: Admin > Plan y módulos.
# Sin licencia válida, en producción el sistema funciona como Nivel 1.
LICENSE_KEY=
# Solo desarrollo (NODE_ENV distinto de production): fuerza un plan sin licencia -> nivel1 | nivel2 | nivel3
# PLAN=nivel3

# --- Correo (elige UNA opción; sin ninguna, los correos solo se escriben en el log) ---
MAIL_FROM=InsurDesk <noreply@tudominio.com>
RESEND_API_KEY=
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- IA (Asistente, Radar IA) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Google (opcional): inicio de sesión con Google ---
# Redirect URI a registrar en Google Cloud:
#   {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Marca y registro ---
BRAND_NAME=InsurDesk
# false = nadie puede registrarse solo; las cuentas se crean por invitación
ALLOW_REGISTRATION=true

# --- Opcionales ---
# Origen permitido para el visor WebXR (vacío = desactivado)
XR_ALLOWED_ORIGIN=
# Si defines esta cadena, los documentos siguen en Azure Blob; si no, se guardan en disco.
AZURE_STORAGE_CONNECTION_STRING=
REPORTING_API_KEY=
XR_READ_TOKEN=
TZ=America/Guayaquil
SCHEDULER_ENABLED=true
